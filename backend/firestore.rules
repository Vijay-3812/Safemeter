rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Device registry: written only by admins (console / scripts). Contains API keys.
    match /devices/{vehicleId} {
      allow read, write: if false;
    }

    // Incidents: created by the ingest function (admin SDK), readable by signed-in
    // volunteers and the dashboard. Status changes go through callable functions.
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Volunteers manage only their own profile.
    match /volunteers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'phone', 'available'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.available is bool;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
